local function CreateStylishButton(name, text, position, imageId)
    local Gui = Instance.new("ScreenGui")
    Gui.Name = name .. "Gui"
    Gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    Gui.Enabled = false

    local Button = Instance.new("TextButton")
    Button.Name = name .. "Button"
    Button.Parent = Gui
    Button.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
    Button.BackgroundTransparency = 0.5
    Button.Position = position
    Button.Size = UDim2.new(0, 80, 0, 90)
    Button.Font = Enum.Font.GothamBold
    Button.Text = ""
    Button.Draggable = true

    local Stroke = Instance.new("UIStroke", Button)
    Stroke.Thickness = 2.5
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Stroke.Color = Color3.fromRGB(255, 255, 255)

    local Gradient = Instance.new("UIGradient", Stroke)
    Gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 50, 50)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 0, 0))
    }

    local Corner = Instance.new("UICorner", Button)
    Corner.CornerRadius = UDim.new(0, 14)

    local BgGradient = Instance.new("UIGradient", Button)
    BgGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 0, 0))
    }
    BgGradient.Rotation = 90

    local Image = Instance.new("ImageLabel")
    Image.Name = "Icon"
    Image.Parent = Button
    Image.BackgroundTransparency = 1
    Image.Size = UDim2.new(0, 48, 0, 48)
    Image.Position = UDim2.new(0.5, -24, 0, 8)
    Image.Image = "rbxassetid://" .. tostring(imageId)
    Image.ScaleType = Enum.ScaleType.Fit

    local Label = Instance.new("TextLabel")
    Label.Name = "Label"
    Label.Parent = Button
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(1, 0, 0, 22)
    Label.Position = UDim2.new(0, 0, 1, -24)
    Label.Font = Enum.Font.GothamBold
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(255, 180, 180)
    Label.TextSize = 10
    Label.TextXAlignment = Enum.TextXAlignment.Center
    Label.TextStrokeTransparency = 0.5
    Label.TextStrokeColor3 = Color3.fromRGB(180, 0, 0)

    return Gui, Button
end

