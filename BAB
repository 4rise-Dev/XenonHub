local function refreshStatus()
    local parts = {}
    if cfg.farmActive then table.insert(parts, "Farm") end
    if cfg.antiAfk    then table.insert(parts, "AntiAFK") end
    if #parts == 0 then
        statusTxt.Text      = "IDLE"
        statusTxt.TextColor3 = Color3.fromRGB(120, 60, 60)
        statusDot.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
    else
        statusTxt.Text      = "กำลังรัน " .. table.concat(parts, " + ") .. "..."
        statusTxt.TextColor3 = Color3.fromRGB(255, 120, 120)
        statusDot.BackgroundColor3 = RED
        startDotPulse()
    end
end

