local farmThread

local function stopFarm()
    cfg.farmActive    = false
    cfg.farmCancelled = true
    if farmThread then task.cancel(farmThread); farmThread = nil end
    farmRow.btn.Text             = "START"
    TweenService:Create(farmRow.btn, TweenInfo.new(0.15), {BackgroundColor3=GREEN}):Play()
    farmRow.dot.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
    farmRow.lbl.TextColor3       = Color3.fromRGB(220, 200, 200)
    farmRow.desc.Text            = "ออโต้ฟาร์มทอง"
    farmRow.desc.TextColor3      = Color3.fromRGB(110, 60, 60)
    refreshStatus()
end

local function startFarm()
    cfg.farmActive    = true
    cfg.farmCancelled = false
    farmRow.btn.Text             = "STOP"
    TweenService:Create(farmRow.btn, TweenInfo.new(0.15), {BackgroundColor3=DARKRED}):Play()
    farmRow.dot.BackgroundColor3 = Color3.fromRGB(100, 255, 130)
    farmRow.lbl.TextColor3       = Color3.fromRGB(255, 150, 150)
    farmRow.desc.Text            = "กำลังฟาร์ม..."
    farmRow.desc.TextColor3      = Color3.fromRGB(200, 120, 120)
    refreshStatus()

    farmThread = task.spawn(function()
        while cfg.farmActive and not cfg.farmCancelled do
            local ok, err = pcall(doRun, notify)
            if not ok then
                notify("Error: " .. tostring(err))
                task.wait(3)
            end
        end
    end)
end

