    cfg.antiAfk = true
    afkRow.btn.Text             = "STOP"
    TweenService:Create(afkRow.btn, TweenInfo.new(0.15), {BackgroundColor3=DARKRED}):Play()
    afkRow.dot.BackgroundColor3 = Color3.fromRGB(255, 200, 100)
    afkRow.lbl.TextColor3       = Color3.fromRGB(255, 210, 140)
    afkRow.desc.Text            = "กำลังป้องกัน..."
    afkRow.desc.TextColor3      = Color3.fromRGB(200, 160, 80)
    refreshStatus()
    startAntiAfk()
end

afkRow.btn.MouseEnter:Connect(function()
    TweenService:Create(afkRow.btn, TweenInfo.new(0.1), {
        BackgroundColor3 = cfg.antiAfk and Color3.fromRGB(160, 30, 30) or Color3.fromRGB(200, 130, 50)
    }):Play()
end)
afkRow.btn.MouseLeave:Connect(function()
    TweenService:Create(afkRow.btn, TweenInfo.new(0.1), {
        BackgroundColor3 = cfg.antiAfk and DARKRED or AFK_ON
    }):Play()
end)
afkRow.btn.MouseButton1Click:Connect(function()
    if cfg.antiAfk then stopAfk() else startAfk() end
end)
