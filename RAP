-- หา Plot ของ LocalPlayer
local function getMyPlot()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, plot in ipairs(plots:GetChildren()) do
		local data  = plot:FindFirstChild("Data")
		local owner = data and data:FindFirstChild("Owner")
		if owner and owner.Value == LocalPlayer then
			return plot
		end
	end
	return nil
end

-- ดึงชื่อไข่ไม่ซ้ำจาก RenderedEggs
local function getEggNames()
	local folder = workspace:FindFirstChild("RenderedEggs")
	if not folder then return {"ไม่พบ RenderedEggs"} end
	local seen, names = {}, {}
	for _, egg in ipairs(folder:GetChildren()) do
		if not seen[egg.Name] then
			seen[egg.Name] = true
			table.insert(names, egg.Name)
		end
	end
	return #names > 0 and names or {"ไม่มีไข่"}
end

-- ดึงไข่ทั้งหมดที่ตรงชื่อที่เลือก
local function getEggsByName(name)
	local folder = workspace:FindFirstChild("RenderedEggs")
	if not folder then return {} end
	local result = {}
	for _, egg in ipairs(folder:GetChildren()) do
		if egg.Name == name then
			table.insert(result, egg)
		end
	end
	return result
end

-- ดึงชื่อไข่ไม่ซ้ำจาก Backpack
local function getEggNamesFromBackpack()
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not backpack then return {} end
	local seen, names = {}, {}
	for _, item in ipairs(backpack:GetChildren()) do
		if item.Name:sub(-3) == "Egg" and not seen[item.Name] then
			seen[item.Name] = true
			table.insert(names, item.Name)
		end
	end
	table.sort(names)
	return names
end

-- ดึงไข่จาก Backpack กรองตามที่เลือก
local function getEggsToPlant()
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not backpack then return {} end
	local result = {}
	for _, item in ipairs(backpack:GetChildren()) do
		if item.Name:sub(-3) == "Egg" then
			if #selectedEggTypes == 0 then
				table.insert(result, item)
			else
				for _, sel in ipairs(selectedEggTypes) do
					if item.Name == sel then
						table.insert(result, item)
						break
					end
				end
			end
		end
	end
	return result
end

-- คำนวณตำแหน่งกระจายรอบตัว
local function getPlantPositions(origin, count)
	local positions = {}
	for i = 1, count do
		local angle  = (2 * math.pi / count) * (i - 1)
		local offset = Vector3.new(
			math.cos(angle) * PLANT_RADIUS,
			0,
			math.sin(angle) * PLANT_RADIUS
		)
		table.insert(positions, origin + offset)
	end
	return positions
end

-- Tween HRP ไปยัง CFrame เป้าหมาย
local function tweenTo(targetCF, overrideSpeed)
	local myChar = LocalPlayer.Character
	local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end
	local dist     = (myHRP.Position - targetCF.Position).Magnitude
	local speed    = overrideSpeed or tweenSpeed
	local duration = math.clamp(dist / speed, 0.05, 10)
	local tween = TweenService:Create(
		myHRP,
		TweenInfo.new(duration, TWEEN_STYLE, TWEEN_DIRECTION),
		{ CFrame = targetCF }
	)
	tween:Play()
	tween.Completed:Wait()
end

-- Tween ไปยัง Plot
local function tweenToPlot(plot)
	local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end
	local basepart = plot:FindFirstChildWhichIsA("BasePart", true)
	if not basepart then return end
	tweenTo(CFrame.new(basepart.Position + Vector3.new(0, 5, 0)))
end

-- Noclip ระหว่าง farm
local function setNoclip(state)
	local char = LocalPlayer.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = not state
		end
	end
end

-- ถือไข่แล้ววาง
local function plantEgg(egg, pos)
	local char = LocalPlayer.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not backpack then return end
	local tool = backpack:FindFirstChild(egg.Name)
	if not tool then return end
	pcall(function() humanoid:EquipTool(tool) end)
	task.wait(0.2)
	pcall(function() PLANT_REMOTE:FireServer({ PlantPosition = pos }) end)
	task.wait(0.2)
	pcall(function() humanoid:UnequipTools() end)
end
-- Pickup ไข่ทั่วไป
-- ==========================================
-- Drop ก่อนถึง Plot แล้วไปเก็บไข่ที่ตก
-- ==========================================
local function dropAndPickupBeforeHome()
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    -- หา homePos
    local myPlot  = getMyPlot()
    local homePos = nil
    if myPlot then
        local bp = myPlot:FindFirstChildWhichIsA("BasePart", true)
        if bp then homePos = bp.Position end
    elseif savedReturnCF then
        homePos = savedReturnCF.Position
    end

    if not homePos then
        -- fallback ไม่รู้ plot → ยิง drop แล้วดิ่งลง
        pcall(function() BasketDropRemote:FireServer() end)
        myHRP.CFrame = myHRP.CFrame * CFrame.new(0, -80, 0)
        task.wait(0.1)
        return
    end

    -- คำนวณจุดที่ห่าง 65 studs จาก Plot
    local currentPos = myHRP.Position
    local dist = (currentPos - homePos).Magnitude

    if dist >= 60 then
        local dir       = (homePos - currentPos).Unit
        local dropPoint = homePos - dir * 65
        tweenTo(CFrame.new(dropPoint + Vector3.new(0, 5, 0)))
        task.wait(0.1)
    end

    -- จำชื่อไข่ที่มีใน RenderedEggs ก่อน drop (snapshot)
    local beforeDrop = {}
    local folder = workspace:FindFirstChild("RenderedEggs")
    if folder then
        for _, egg in ipairs(folder:GetChildren()) do
            beforeDrop[egg] = true
        end
    end

    -- ยิง BasketDrop
    pcall(function() BasketDropRemote:FireServer() end)

    -- รอไข่ใหม่ spawn ใน RenderedEggs (timeout 5 วิ)
    local droppedEgg = nil
    local deadline   = os.clock() + 5

    while os.clock() < deadline do
        task.wait(0.15)
        local f = workspace:FindFirstChild("RenderedEggs")
        if f then
            for _, egg in ipairs(f:GetChildren()) do
                if not beforeDrop[egg] then
                    droppedEgg = egg
                    break
                end
            end
        end
        if droppedEgg then break end
    end

    -- ถ้าเจอไข่ที่ตกลงมา → บินไปเก็บ
    if droppedEgg then
        pcall(function() pickupEggRaw(droppedEgg) end)
    end

    -- กลับ Plot
    if myPlot then
        tweenToPlot(myPlot)
    elseif savedReturnCF then
        tweenTo(savedReturnCF)
    else
        myHRP.CFrame = myHRP.CFrame * CFrame.new(0, -80, 0)
        task.wait(0.1)
    end
end

