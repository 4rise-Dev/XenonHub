local function getEggIcon(name)
	if type(GameData) ~= "table" then return "egg" end
	local data = GameData[name] or GameData[name:gsub("%s*Egg%s*$", "")]
	if not data then return "egg" end
	for _, key in ipairs({"Image","ImageId","Icon","IconId","Thumbnail","ThumbnailId","Texture","TextureId"}) do
		local val = data[key]
		if val then
			local str = tostring(val)
			if str ~= "" then
				if str:find("rbxassetid://",1,true)==1 or str:find("rbxthumb://",1,true)==1 then
					return str
				end
				local id = str:match("(%d+)")
				if id then return "rbxassetid://" .. id end
			end
		end
	end
	return "egg"
end

local function buildEggValues(nameList)
	local list = {}
	for _, name in ipairs(nameList) do
		local info = EGG_RARITY[name]
		table.insert(list, {
			rawName  = name,
			priority = info and info.priority or 0,
			rarity   = info and info.rarity   or "?",
			icon     = getEggIcon(name),
		})
	end
	table.sort(list, function(a, b)
		if a.priority ~= b.priority then return a.priority > b.priority end
		return a.rawName < b.rawName
	end)
	local values = {}
	for _, item in ipairs(list) do
		local label = item.rawName:gsub("%s*Egg%s*$","") .. " [" .. item.rarity .. "]"
		table.insert(values, { Title = label, Icon = item.icon, _raw = item.rawName })
	end
	return values
end

local function labelToRaw(label, valueList)
	for _, v in ipairs(valueList) do
		if type(v) == "table" and v.Title == label then
			return v._raw
		end
	end
	return label
end

local function getRenderedEggNames()
	local folder = workspace:FindFirstChild("RenderedEggs")
	if not folder then return {} end
	local seen, names = {}, {}
	for _, egg in ipairs(folder:GetChildren()) do
		if not seen[egg.Name] then
			seen[egg.Name] = true
			table.insert(names, egg.Name)
		end
	end
	return names
end

