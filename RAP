	end

	espConn = RunService.Heartbeat:Connect(function()
		local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

		-- อัปเดต label ที่มีอยู่
		for _, bb in ipairs(espFolder:GetChildren()) do
			local lbl = bb:FindFirstChild("Label")
			if not lbl or not bb.Adornee then continue end

			local adornee = bb.Adornee
			if not adornee or not adornee.Parent then
				bb:Destroy()
				continue
			end

			local eggName = adornee.Parent and adornee.Parent.Name or adornee.Name
			local dist    = 0
			if myHRP then
				dist = math.floor((adornee.Position - myHRP.Position).Magnitude)
			end
			lbl.Text = eggName .. "\n📏 " .. dist .. " studs"
		end

		-- เพิ่ม label ให้ไข่ใหม่ที่เกิดขึ้น
		local folder2 = getEggFolder()
		if folder2 then
			for _, egg in ipairs(folder2:GetChildren()) do
				local key = "ESP_" .. egg:GetDebugId()
				if not espFolder:FindFirstChild(key) then
					pcall(function() createEggLabel(egg) end)
				end
			end
		end
	end)

	Notify("ESP", "Egg ESP เปิดแล้ว", "eye", 2)
end

local function stopESP()
	espActive = false
	if espConn then
		espConn:Disconnect()
		espConn = nil
	end
	clearAllESP()
	Notify("ESP", "Egg ESP ปิดแล้ว", "eye-off", 2)
end

