local UserInputService = game:GetService("UserInputService")

LocalTab:Section({ Title="LocalPlayer", Icon="user", Opened=true })

local WalkSpeed    = 16
local JumpPower    = 50
local SpeedEnabled = false
local JumpEnabled  = false
local InfiniteJump = false
local NoclipEnabled = false
local noclipConnection = nil
local infiniteJumpConnection = nil

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "LocalPlayerESP"
ESPFolder.Parent = game:GetService("CoreGui")

local function getCharacter()
    local c = LocalPlayer.Character
    return (c and c.Parent) and c or nil
end
local function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid") or nil
end

local function applyMovement()
    local h = getHumanoid()
    if not h then return end
    h.WalkSpeed  = SpeedEnabled and WalkSpeed or 16
    h.UseJumpPower = true
    h.JumpPower  = JumpEnabled  and JumpPower  or 50
end

LocalTab:Slider({
    Title="Walk Speed", Desc="ปรับความเร็วในการวิ่ง",
    Value={ Min=16, Max=300, Default=16 },
    Callback=function(v) WalkSpeed=tonumber(v) or 16; if SpeedEnabled then applyMovement() end end
})
LocalTab:Toggle({
    Title="Speed Boost", Desc="เปิด/ปิด WalkSpeed", Icon="zap", Value=false,
    Callback=function(v) SpeedEnabled=v; applyMovement(); WindUI:Notify({ Title="LocalPlayer", Content=v and "เปิดวิ่งเร็วแล้ว" or "ปิดวิ่งเร็วแล้ว", Duration=2 }) end
})
LocalTab:Space()

LocalTab:Slider({
    Title="Jump Power", Desc="ปรับความสูงของการกระโดด",
    Value={ Min=50, Max=300, Default=50 },
    Callback=function(v) JumpPower=tonumber(v) or 50; if JumpEnabled then applyMovement() end end
})
LocalTab:Toggle({
    Title="Jump Boost", Desc="เปิด/ปิด JumpPower", Icon="arrow-up", Value=false,
    Callback=function(v) JumpEnabled=v; applyMovement(); WindUI:Notify({ Title="LocalPlayer", Content=v and "เปิดกระโดดสูงแล้ว" or "ปิดกระโดดสูงแล้ว", Duration=2 }) end
})
LocalTab:Space()

local function stopInfiniteJump()
    if infiniteJumpConnection then infiniteJumpConnection:Disconnect(); infiniteJumpConnection=nil end
end
local function startInfiniteJump()
    stopInfiniteJump()
    infiniteJumpConnection = UserInputService.JumpRequest:Connect(function()
        if not InfiniteJump then return end
        local h = getHumanoid()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
end

LocalTab:Toggle({
    Title="infJump", Desc="สามารถกระโดดกลางอากาศได้", Icon="infinity", Value=false,
    Callback=function(v)
        InfiniteJump=v
        if v then startInfiniteJump() else stopInfiniteJump() end
        WindUI:Notify({ Title="LocalPlayer", Content=v and "เปิดกระโดดไม่จำกัดแล้ว" or "ปิดกระโดดไม่จำกัดแล้ว", Duration=2 })
    end
})
LocalTab:Space()

local function stopNoclip()
    if noclipConnection then noclipConnection:Disconnect(); noclipConnection=nil end
    local c = getCharacter()
    if c then for _,o in ipairs(c:GetDescendants()) do if o:IsA("BasePart") then o.CanCollide=true end end end
end
local function startNoclip()
    stopNoclip()
    noclipConnection = RunService.Stepped:Connect(function()
        if not NoclipEnabled then return end
        local c = getCharacter()
        if not c then return end
        for _,o in ipairs(c:GetDescendants()) do if o:IsA("BasePart") then o.CanCollide=false end end
    end)
end

LocalTab:Toggle({
    Title="Noclip", Desc="เปิด/ปิด Noclip", Icon="ghost", Value=false,
    Callback=function(v)
        NoclipEnabled=v
        if v then startNoclip() else stopNoclip() end
        WindUI:Notify({ Title="LocalPlayer", Content=v and "เปิดทะลุกำแพงแล้ว" or "ปิดทะลุกำแพงแล้ว", Duration=2 })
    end
})
LocalTab:Space()

local function clearESP()
    for _,o in ipairs(ESPFolder:GetChildren()) do o:Destroy() end
end
local function createESP(player)
    if player==LocalPlayer or not ESPEnabled then return end
    local char = player.Character
    if not char then return end
    local old = ESPFolder:FindFirstChild(player.Name)
    if old then old:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = player.Name
    hl.Adornee = char
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillTransparency = 0.65
    hl.OutlineTransparency = 0
    hl.Parent = ESPFolder
end
local function updateESP()
    if not ESPEnabled then clearESP(); return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then createESP(p) end
    end
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(0.5); if ESPEnabled then createESP(p) end end)
end)
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5); applyMovement()
    if NoclipEnabled then startNoclip() end
end)


