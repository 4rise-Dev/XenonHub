local VOLCANO_EGGS         = { ["Dragon Egg"] = true, ["Volcanic Egg"] = true }
local VOLCANO_ENTRANCE_POS = Vector3.new(-4939.836, 41284.703, -3679.983)
local VOLCANO_VALIDATE_POS = Vector3.new(-4966.714, 41282.770, -3656.444)

local function isVolcanoEgg(eggName)
    return VOLCANO_EGGS[eggName] == true
end

-- ทิศทางจาก Entrance → Validate (เข้าใน)
local ENTER_DIR = (VOLCANO_VALIDATE_POS - VOLCANO_ENTRANCE_POS).Unit
-- ทิศทางออก (ตรงข้าม)
local EXIT_DIR  = -ENTER_DIR

local function enterVolcano()
    -- บินมาหน้าประตู Entrance
    tweenTo(CFrame.new(VOLCANO_ENTRANCE_POS + Vector3.new(0, 5, 0)))
    task.wait(0.1)

    -- บินเข้าไปอีก 2-3 studs หลังผ่านประตู
    tweenTo(CFrame.new(VOLCANO_ENTRANCE_POS + ENTER_DIR * 3 + Vector3.new(0, 5, 0)))
    task.wait(0.1)

    -- บินไป VolcanoValidate
    tweenTo(CFrame.new(VOLCANO_VALIDATE_POS + Vector3.new(0, 3, 0)))
    task.wait(0.1)

    -- บินเข้าไปอีก 2-3 studs หลังผ่าน Validate
    tweenTo(CFrame.new(VOLCANO_VALIDATE_POS + ENTER_DIR * 3 + Vector3.new(0, 3, 0)))
    task.wait(0.2)
end

local function exitVolcano()
    -- บินกลับมาที่ VolcanoValidate
    tweenTo(CFrame.new(VOLCANO_VALIDATE_POS + Vector3.new(0, 3, 0)))
    task.wait(0.1)

    -- บินออกไปอีก 2-3 studs หลังผ่าน Validate ขาออก
    tweenTo(CFrame.new(VOLCANO_VALIDATE_POS + EXIT_DIR * 3 + Vector3.new(0, 3, 0)))
    task.wait(0.1)

    -- บินกลับมาที่ Entrance
    tweenTo(CFrame.new(VOLCANO_ENTRANCE_POS + Vector3.new(0, 5, 0)))
    task.wait(0.1)

    -- บินออกมาข้างนอก 2-3 studs
    tweenTo(CFrame.new(VOLCANO_ENTRANCE_POS + EXIT_DIR * 3 + Vector3.new(0, 5, 0)))
    task.wait(0.2)
end

local function pickupVolcanoEgg(egg)
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local pickup = nil
    for _, v in ipairs(egg:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Name == "Pickup" then
            pickup = v
            break
        end
    end
    if not pickup then return end

    local attachPart = pickup.Parent
    if not attachPart or not attachPart:IsA("BasePart") then return end

    -- บินเข้า Volcano ผ่านประตู
    enterVolcano()

    -- บินไปหาไข่
    tweenTo(attachPart.CFrame * CFrame.new(0, 3, 0))
    task.wait(0.1)

    fireproximityprompt(pickup, pickup.HoldDuration)
    task.wait(pickup.HoldDuration + 0.85)

    -- บินออก Volcano ผ่านประตู
    exitVolcano()
    
    -- กลับบ้าน
    returnHome(myHRP)
end

